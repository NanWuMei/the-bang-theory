# Database — Supabase PostgreSQL
# Dashboard: https://supabase.com/dashboard/project/dlkxlxtwszgrnxoctdgt
# 详见 docs/supabase-setup.md

# 直连（推荐 db:migrate）
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.dlkxlxtwszgrnxoctdgt.supabase.co:5432/postgres
DATABASE_SSL=true

# 运行时也可改用 Session Pooler（region 以 Dashboard 为准）:
# DATABASE_URL=postgresql://postgres.dlkxlxtwszgrnxoctdgt:YOUR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Supabase Storage（Step 6 — 上传视频/切片）
SUPABASE_URL=https://dlkxlxtwszgrnxoctdgt.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Meilisearch
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=dev-master-key

# Redis
REDIS_URL=redis://localhost:6379

# MinIO (S3-compatible)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=tbbt-media

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Media processing (Phase 3)
FFMPEG_PATH=ffmpeg
CLIP_PADDING_MS=200
LOCAL_VIDEOS_DIR=data/raw/videos
MEDIA_CACHE_DIR=data/cache

# OpenSubtitles（下载字幕用，见 data/raw/README.md）
OPENSUBTITLES_API_KEY=
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=
